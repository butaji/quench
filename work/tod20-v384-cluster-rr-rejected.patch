+pub(crate) fn cluster_listen_start(
+    context: &mut Context<'_>,
+    server: RootId,
+    args: &[RootId],
+) -> Result<RootId, RootedError> {
+    let options = args[0];
+    let resource = listen_resource(context, &[options])?;
+    check_net_permission(context, resource.as_deref())?;
+    publish_listen_event(context, "start", server, Some(options), None)?;
+    publish_listen_event(context, "asyncStart", server, Some(options), None)?;
+    advance(context, server)
+}
+
+pub(crate) fn cluster_listen_end(
+    context: &mut Context<'_>,
+    server: RootId,
+    args: &[RootId],
+) -> Result<RootId, RootedError> {
+    publish_listen_event(context, "asyncEnd", server, Some(args[0]), None)?;
+    publish_listen_event(context, "end", server, Some(args[0]), None)?;
+    Ok(server)
+}
+
+pub(crate) fn cluster_listen_error(
+    context: &mut Context<'_>,
+    server: RootId,
+    args: &[RootId],
+) -> Result<RootId, RootedError> {
+    publish_listen_event(context, "error", server, None, Some(args[0]))?;
+    publish_listen_event(context, "end", server, None, None)?;
+    emit(context, server, "error", &[args[0]])
+}
