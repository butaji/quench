            Self::LoadLocal { .. } => Some(crate::ir::Opcode::LoadLocal),
            Self::MakeArray { .. } => Some(crate::ir::Opcode::MakeArray),
            Self::TemplateObject { .. } => None,
            Self::BuildArray { .. } => None,
            Self::MakeObject { .. } => Some(crate::ir::Opcode::MakeObject),
            Self::MakeGlobalObjectView { .. } => None,
            Self::MakeBuiltin { .. } => Some(crate::ir::Opcode::MakeBuiltin),
            Self::GetProperty { .. } => Some(crate::ir::Opcode::GetN),
            Self::OptionalGet { .. } => None,
            Self::OptionalGetPrivate { .. } => None,
            Self::OptionalGetDynamic { .. } => None,
            Self::GetPrivate { .. } => None,
            Self::HasPrivate { .. } => None,
            Self::GetSuperProperty { .. } => None,
