            Self::CheckStrictName { .. } => "CheckStrictName",
            Self::SetFunctionName { .. } => "SetFunctionName",
            Self::SetFunctionNameDynamic { .. } => "SetFunctionNameDynamic",
            Self::GetPropertyDynamic { .. } => "GetPropertyDynamic",
            Self::HasPropertyDynamic { .. } => "HasPropertyDynamic",
            Self::ToPropertyKey { .. } => "ToPropertyKey",
            Self::RequireObjectCoercible { .. } => "RequireObjectCoercible",
            Self::GetIterator { .. } => "GetIterator",
            Self::IteratorStep { .. } => "IteratorStep",
            Self::IteratorRest { .. } => "IteratorRest",
            Self::ValidateClassHeritage { .. } => "ValidateClassHeritage",
            Self::GetClassPrototype { .. } => "GetClassPrototype",
            Self::CheckSuperThis => "CheckSuperThis",
            Self::AppendInstanceField (..) => "AppendInstanceField",
            Self::SetProperty { .. } => "SetProperty",
            Self::SetPrototype { .. } => "SetPrototype",
            Self::SetPrivate { .. } => "SetPrivate",
            Self::DefinePrivate { .. } => "DefinePrivate",
            Self::SetPropertyDynamic { .. } => "SetPropertyDynamic",
            Self::DefineProperty { .. } => "DefineProperty",
            Self::CopyDataProperties { .. } => "CopyDataProperties",
