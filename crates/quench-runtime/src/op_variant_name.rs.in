    pub const fn variant_name(&self) -> &'static str {
        match self {
            #[cfg(feature = "execution-trace")]
            Self::TraceSite { .. } => "TraceSite",
            Self::Const { .. } => "Const",
            Self::StoreLocal { .. } => "StoreLocal",
            Self::Move { .. } => "Move",
            Self::MakeRest { .. } => "MakeRest",
            Self::AliasLocal { .. } => "AliasLocal",
            Self::StoreFunctionName { .. } => "StoreFunctionName",
            Self::LoadCurrentGlobal { .. } => "LoadCurrentGlobal",
            Self::MarkUninitialized { .. } => "MarkUninitialized",
            Self::MarkImmutable { .. } => "MarkImmutable",
            Self::CheckInitialized { .. } => "CheckInitialized",
            Self::InitializeLocal { .. } => "InitializeLocal",
            Self::LoadParameter { .. } => "LoadParameter",
            Self::DeclareEvalBinding { .. } => "DeclareEvalBinding",
            Self::DeclareGlobalLexicalBinding { .. } => "DeclareGlobalLexicalBinding",
            Self::DeleteEvalBinding { .. } => "DeleteEvalBinding",
            Self::DeleteName { .. } => "DeleteName",
            Self::CheckGlobalFunction { .. } => "CheckGlobalFunction",
            Self::CheckGlobalVar { .. } => "CheckGlobalVar",
            Self::CreateGlobalFunction { .. } => "CreateGlobalFunction",
            Self::CreateGlobalVar { .. } => "CreateGlobalVar",
            Self::ResolveBindingTarget { .. } => "ResolveBindingTarget",
            Self::ResolveActiveBindingTarget { .. } => "ResolveActiveBindingTarget",
            Self::InitializeResolvedBinding { .. } => "InitializeResolvedBinding",
            Self::SetResolvedLocalBinding { .. } => "SetResolvedLocalBinding",
            Self::LoadResolvedLocalBinding { .. } => "LoadResolvedLocalBinding",
            Self::LoadBinding { .. } => "LoadBinding",
            Self::LoadResolvedBinding { .. } => "LoadResolvedBinding",
            Self::LoadLocal { .. } => "LoadLocal",
            Self::MakeArray { .. } => "MakeArray",
            Self::TemplateObject { .. } => "TemplateObject",
            Self::BuildArray { .. } => "BuildArray",
            Self::MakeObject { .. } => "MakeObject",
            Self::MakeGlobalObjectView { .. } => "MakeGlobalObjectView",
            Self::MakeBuiltin { .. } => "MakeBuiltin",
            Self::GetProperty { .. } => "GetProperty",
            Self::OptionalGet { .. } => "OptionalGet",
            Self::OptionalGetPrivate { .. } => "OptionalGetPrivate",
            Self::OptionalGetDynamic { .. } => "OptionalGetDynamic",
            Self::GetPrivate { .. } => "GetPrivate",
            Self::HasPrivate { .. } => "HasPrivate",
            Self::GetSuperProperty { .. } => "GetSuperProperty",
            Self::GetSuperPropertyDynamic { .. } => "GetSuperPropertyDynamic",
            Self::SetSuperProperty { .. } => "SetSuperProperty",
            Self::SetSuperPropertyDynamic { .. } => "SetSuperPropertyDynamic",
            Self::CaptureSuperBase { .. } => "CaptureSuperBase",
            Self::ResolveGlobal { .. } => "ResolveGlobal",
            Self::ResolveName { .. } => "ResolveName",
            Self::ResolveStrictName { .. } => "ResolveStrictName",
            Self::ResolveNameOrUndefined { .. } => "ResolveNameOrUndefined",
            Self::SetName { .. } => "SetName",
