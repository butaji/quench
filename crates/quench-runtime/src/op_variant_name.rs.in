            Self::SetName { .. } => None,
            Self::SetResolvedBinding { .. } => None,
            Self::CheckStrictName { .. } => None,
            Self::SetFunctionName { .. } => Some(crate::ir::Opcode::SetFunctionName),
            Self::SetFunctionNameDynamic { .. } => None,
            Self::GetPropertyDynamic { .. } => Some(crate::ir::Opcode::AGetI),
            Self::HasPropertyDynamic { .. } => None,
            Self::ToPropertyKey { .. } => None,
            Self::RequireObjectCoercible { .. } => Some(crate::ir::Opcode::RequireObjectCoercible),
            Self::GetIterator { .. } => None,
            Self::IteratorStep { .. } => None,
