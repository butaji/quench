    /// Resolve a canonical operation to its generated typed cold opcode.
    /// Every variant has an explicit arm. `None` means that the operation has
    /// no typed cold spelling; its ordinary compact lowering or named generic
    /// semantic fallback owns the next boundary. `Call`/`CallSlow` and
    /// `Loop`/`ForI` are intentional physical-name aliases in the
    /// declaration. Keeping these arms exhaustive makes a
    /// new variant visible to this physical lowering audit instead of silently
    /// entering a wildcard branch.
    pub const fn cold_opcode(&self) -> Option<crate::ir::Opcode> {
        match self {
        #[cfg(feature = "execution-trace")]
            Self::TraceSite { .. } => None,
            Self::Const { .. } => None,
            Self::StoreLocal { .. } => None,
            Self::Move { .. } => None,
            Self::MakeRest { .. } => None,
            Self::AliasLocal { .. } => None,
            Self::StoreFunctionName { .. } => None,
            Self::LoadCurrentGlobal { .. } => None,
            Self::MarkUninitialized { .. } => Some(crate::ir::Opcode::MarkUninitialized),
            Self::MarkImmutable { .. } => Some(crate::ir::Opcode::MarkImmutable),
            Self::CheckInitialized { .. } => None,
            Self::InitializeLocal { .. } => None,
            Self::LoadParameter { .. } => None,
            Self::DeclareEvalBinding { .. } => None,
            Self::DeclareGlobalLexicalBinding { .. } => None,
            Self::DeleteEvalBinding { .. } => None,
            Self::DeleteName { .. } => None,
            Self::CheckGlobalFunction { .. } => None,
            Self::CheckGlobalVar { .. } => None,
            Self::CreateGlobalFunction { .. } => None,
            Self::CreateGlobalVar { .. } => None,
            Self::ResolveBindingTarget { .. } => None,
            Self::ResolveActiveBindingTarget { .. } => None,
            Self::InitializeResolvedBinding { .. } => None,
            Self::SetResolvedLocalBinding { .. } => None,
            Self::LoadResolvedLocalBinding { .. } => None,
            Self::LoadBinding { .. } => None,
            Self::LoadResolvedBinding { .. } => None,
            Self::LoadLocal { .. } => None,
            Self::MakeArray { .. } => Some(crate::ir::Opcode::MakeArray),
            Self::TemplateObject { .. } => None,
            Self::BuildArray { .. } => None,
            Self::MakeObject { .. } => Some(crate::ir::Opcode::MakeObject),
            Self::MakeGlobalObjectView { .. } => None,
            Self::MakeBuiltin { .. } => Some(crate::ir::Opcode::MakeBuiltin),
            Self::GetProperty { .. } => None,
            Self::OptionalGet { .. } => None,
            Self::OptionalGetPrivate { .. } => None,
            Self::OptionalGetDynamic { .. } => None,
            Self::GetPrivate { .. } => None,
            Self::HasPrivate { .. } => None,
            Self::GetSuperProperty { .. } => None,
            Self::GetSuperPropertyDynamic { .. } => None,
            Self::SetSuperProperty { .. } => None,
            Self::SetSuperPropertyDynamic { .. } => None,
            Self::CaptureSuperBase { .. } => None,
            Self::ResolveGlobal { .. } => None,
            Self::ResolveName { .. } => None,
            Self::ResolveStrictName { .. } => None,
            Self::ResolveNameOrUndefined { .. } => None,
            Self::SetName { .. } => None,
            Self::SetResolvedBinding { .. } => None,
            Self::CheckStrictName { .. } => None,
            Self::SetFunctionName { .. } => Some(crate::ir::Opcode::SetFunctionName),
            Self::SetFunctionNameDynamic { .. } => None,
            Self::GetPropertyDynamic { .. } => None,
