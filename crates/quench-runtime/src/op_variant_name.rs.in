    /// One generated row for every canonical operation variant.  `None`
    /// means the instance is compact-lowered or uses its named generic
    /// fallback; operation-specific fields decide which at lowering time.
    /// The table is derived from `Op` and the physical opcode catalog, so it
    /// cannot become a second hand-maintained coverage list.
    pub const LOWERING_MATRIX: &'static [CanonicalOpLowering] = &[
        #[cfg(feature = "execution-trace")]
        CanonicalOpLowering { name: "TraceSite", physical_opcode: None, typed_cold_opcode: None },
        CanonicalOpLowering { name: "Const", physical_opcode: Some(crate::ir::Opcode::LoadConst), typed_cold_opcode: None },
