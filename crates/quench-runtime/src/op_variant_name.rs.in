#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct CanonicalOpLowering {
    pub name: &'static str,
    pub physical_opcode: Option<crate::ir::Opcode>,
    pub typed_cold_opcode: Option<crate::ir::Opcode>,
}
impl CanonicalOpLowering {
    /// Borrow shared operand/effect/control facts for this physical row.
    pub const fn operation_spec(self) -> Option<&'static crate::facts::OperationSpec> {
        match self.physical_opcode {
            Some(opcode) => Some(opcode.spec()),
            None => None,
        }
    }
}

impl Op {
    /// Exhaustive names of the canonical operation variants.  This view is
    /// generated from the enum declaration so coverage audits cannot silently
    /// omit a newly added operation.
    pub const VARIANT_NAMES: &'static [&'static str] = &[
