    { "commit": null, "change": "Rejected debug-info removal experiment.", "cause": "It changed route startup from 127.9 ms to 127.0 ms and route workload from 40.0 ms to 39.9 ms; the sub-1% differences were within run noise and it was reverted." },
    { "commit": null, "change": "Rejected post-bootstrap concatenation experiment.", "cause": "A single eval reduced checked-in host boilerplate but failed compatibility: separate evals preserve cross-fragment top-level lexical bindings, and concatenation caused redeclaration/initialization exceptions even with per-fragment block wrappers. No runtime change was retained." },
    { "commit": null, "change": "Rejected debug-assertions=false profile experiment.", "cause": "With opt-level 3 retained, disabling debug assertions produced approximate direct medians of 220 ms route-load, 160 ms props-json, and 105 ms ssr-response versus the 151.8/138.4/96.3 ms baseline; it was reverted." },
    { "commit": null, "change": "Skip empty post-bootstrap fragments in the generated evaluator.", "cause": "Compatibility passed, but the seven-run Next.js benchmark did not show a stable improvement on this host; retained as a zero-semantics-overhead cleanup." },
    { "commit": null, "change": "Fast path exact readFileSync(string, utf8) calls.", "cause": "Compatibility passed; direct filesystem-loop measurements varied around an 8% improvement, below the 10% commit threshold, while the full Next.js run remained noisy." },
    { "commit": null, "change": "Rejected release panic=abort build experiment.", "cause": "Five-run controls remained within noise of the normal release profile (about 40–50 ms per scenario); it offered no qualifying improvement and was not made part of the project profile." }
