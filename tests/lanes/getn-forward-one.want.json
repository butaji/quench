{
  "schema": 1,
  "metrics": {
    "forward_hit_per_iteration": {
      "numerator": { "top": { "path": "lanes.l1.kernels", "key": "id", "value": "shape_forward_one", "field": "hits" } },
      "denominator": "events.loop_iteration",
      "min_traffic": 100000,
      "min": 0.99
    },
    "leaf_attempt_per_iteration": {
      "numerator": "lanes.l1.leaf.attempt",
      "denominator": "events.loop_iteration",
      "min_traffic": 100000,
      "max": 0.02
    }
  }
}
