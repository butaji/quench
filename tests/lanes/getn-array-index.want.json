    },
    "packed_get_per_iteration": {
      "numerator": "lanes.l0.packed_get",
      "denominator": "events.loop_iteration",
      "min_traffic": 100000,
      "min": 0.99
    },
    "decode_per_iteration": {
      "numerator": "lanes.l0.value_decode",
      "denominator": "events.loop_iteration",
      "min_traffic": 100000,
      "max": 0.02
    }
  }
}
