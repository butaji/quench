+#[test]
+fn pooled_frame_register_setup_clears_only_entry_live_registers() {
+    let mut frame = super::Frame {
+        context: super::activation::CallContext::Internal,
+        original_arguments: vec![],
+        program: super::program_store::ProgramId::MAIN,
+        function: 0,
+        pc: 0,
+        binding_site_pc: None,
+        env: Value::NULL,
+        this: Value::UNDEFINED,
+        locals: vec![],
+        dynamic_bindings: vec![],
+        captured: false,
+        registers: vec![Value::heap(11), Value::heap(12), Value::heap(13)],
+        active_iterators: vec![],
+        with_objects: Vec::new(),
+        with_base: 0,
+    };
+
+    frame.prepare_registers(3, Some((1 << 0) | (1 << 2)));
+    assert_eq!(
+        frame.registers,
+        [Value::UNDEFINED, Value::heap(12), Value::UNDEFINED]
+    );
+    frame.prepare_registers(3, Some(0));
+    assert_eq!(
+        frame.registers,
+        [Value::UNDEFINED, Value::heap(12), Value::UNDEFINED]
+    );
+    frame.prepare_registers(3, None);
+    assert_eq!(frame.registers, [Value::UNDEFINED; 3]);
+}
