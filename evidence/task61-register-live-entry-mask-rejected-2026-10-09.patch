 }
 
+impl ResidualProgram {
+    pub(crate) fn register_roots_at(&self, function: &Function, pc: usize) -> Option<u64> {
+        let offset = function.register_root_offset;
+        if offset == NO_REGISTER_ROOT_MAP {
+            return None;
+        }
+        self.register_roots
+            .get(usize::try_from(offset).ok()?.checked_add(pc)?)
+            .copied()
+    }
+}
