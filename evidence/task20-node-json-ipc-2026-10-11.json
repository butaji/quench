  "scope": "Default JSON IPC transport and lifecycle, fork projection onto spawn, shared CommonJS CLI entry resolution, Unix filesystem descriptor namespace and inherited IO, and stdio pipe destination lifetime.",
  "oracle": "v27.0.0-nightly20260819c79868f102",
