    },
    "scenario_80": {
      "size_bytes_projected": 80,
      "assumptions": [
        "Scenario 96.",
        "Compact Environment program and binding_site_pc Option<u32> to named u32 sentinel fields, reducing the 87 B payload to 79 B.",
        "TemporalZonedDateTime remains 79 B and keeps 16-byte alignment."
      ],
      "dominant_remaining_payload": "Environment and TemporalZonedDateTime: 79 B; enum align 16 B."
    },
    "scenario_56": {
      "size_bytes_projected": 56,
      "assumptions": [
        "Move every variant payload larger than Array (55 B) behind a shared or boxed payload.",
        "Move the i128-aligned Temporal variants out of the enum.",
        "Cell alignment then falls to 8 B; Array payload 55 B plus enum tag rounds to 56 B."
      ],
      "risk": "Broad representation changes; allocation and hot-access costs must be measured rather than inferred from the slot saving."
    }
