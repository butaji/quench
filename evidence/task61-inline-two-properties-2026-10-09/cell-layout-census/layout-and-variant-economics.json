    "scenario_96": {
      "size_bytes_projected": 96,
      "assumptions": [
        "Box WeakMap, Iterator and TemporalDuration payloads.",
        "Store RegExp source/flags/matcher in shared immutable literal data instead of boxing a per-evaluation payload.",
        "Environment payload remains 87 B; TemporalZonedDateTime keeps 16-byte alignment."
