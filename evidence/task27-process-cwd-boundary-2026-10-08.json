  "change": {
    "authority": "ProcessCwd(Rc<RefCell<PathBuf>>) is created once by ProcessState and its shallow handle is stored in SharedNodeState; both adapters and all host path consumers observe the same logical cwd.",
    "preserved_semantics": [
      "shared process.chdir validates and updates logical cwd without changing the host process cwd",
      "legacy process.chdir calls set_current_dir before publishing its lexical logical cwd",
      "shared path.resolve still calls the live guest process.cwd function before its native fallback"
    ],
    "runtime_dependency_removed": false
