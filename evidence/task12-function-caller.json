  "representation": {
    "authority": "The existing native activation stack stores callable, entry frame depth and named Forward/Opaque boundary; active_native_callable derives the callable for all existing native environment, Promise job, Error and revoker consumers. GC derives callable roots from the same records.",
    "caller": "Walk existing CallContext frames by callable identity. Skip direct-eval frames; hide strict, async, generator, foreign-realm, indirect-eval, internal and opaque-native callers. Eligibility derives from strictness, constructibility and class metadata, replacing function-name sentinels.",
    "scope": "No parallel caller stack, arguments snapshot allocation, frame field, fixture branch, benchmark special case or duplicate semantic unit test."
  },
  "contract": {
    "proposal_cited_by_pinned_tests": "https://github.com/claudepache/es-legacy-function-reflection/blob/master/spec.md",
    "status": "Legacy-reflection proposal, not a claim that its optional behavior is universally standardized or matches current Node.",
    "pinned_fixture": "staging/sm/Function/function-caller-restrictions.js requires null async/generator callers; extensions/function-caller-skips-eval-frames.js requires transparent direct eval.",
    "native_boundary": "Function.call/apply, bound calls, Reflect.apply/construct and direct eval forward the caller. Other native activations remain opaque. Indirect eval has no visible function context."
  },
