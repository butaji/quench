(assert_return (invoke $c "foreign-ref" (i32.const 1)) (i32.const 37))
(assert_return (invoke $a "direct" (i32.const 2)) (i32.const 31))
(assert_return (invoke $a "reference" (i32.const 2)) (i32.const 37))
(assert_return (invoke $a "cross" (i32.const 2)) (i32.const 17))
(assert_return (invoke $b "cross" (i32.const 2)) (i32.const 19))
(assert_return (invoke $c "foreign-direct" (i32.const 2)) (i32.const 31))
(assert_return (invoke $c "foreign-ref" (i32.const 2)) (i32.const 37))
(assert_return (invoke $a "direct" (i32.const 37)) (i32.const 31))
(assert_return (invoke $a "reference" (i32.const 37)) (i32.const 37))
(assert_return (invoke $a "cross" (i32.const 37)) (i32.const 19))
(assert_return (invoke $b "cross" (i32.const 37)) (i32.const 17))
(assert_return (invoke $c "foreign-direct" (i32.const 37)) (i32.const 31))
(assert_return (invoke $c "foreign-ref" (i32.const 37)) (i32.const 37))
(assert_return (invoke $a "direct" (i32.const 100000)) (i32.const 31))
(assert_return (invoke $a "reference" (i32.const 100000)) (i32.const 37))
(assert_return (invoke $a "cross" (i32.const 100000)) (i32.const 17))
(assert_return (invoke $b "cross" (i32.const 100000)) (i32.const 19))
(assert_return (invoke $c "foreign-direct" (i32.const 100000)) (i32.const 31))
(assert_return (invoke $c "foreign-ref" (i32.const 100000)) (i32.const 37))
(assert_return (invoke $a "multi" (i64.const 0) (i32.const 0)) (i64.const 0) (i32.const 0))
(assert_return (invoke $a "multi-ref" (i64.const 0) (i32.const 0)) (i64.const 0) (i32.const 0))
(assert_return (invoke $a "multi-indirect" (i64.const 0) (i32.const 0)) (i64.const 0) (i32.const 0))
(assert_return (invoke $c "foreign-multi" (i64.const 0) (i32.const 0)) (i64.const 0) (i32.const 0))
(assert_return (invoke $a "multi" (i64.const 9223372036854775807) (i32.const -2147483648)) (i64.const 9223372036854775807) (i32.const -2147483648))
(assert_return (invoke $a "multi-ref" (i64.const 9223372036854775807) (i32.const -2147483648)) (i64.const 9223372036854775807) (i32.const -2147483648))
(assert_return (invoke $a "multi-indirect" (i64.const 9223372036854775807) (i32.const -2147483648)) (i64.const 9223372036854775807) (i32.const -2147483648))
(assert_return (invoke $c "foreign-multi" (i64.const 9223372036854775807) (i32.const -2147483648)) (i64.const 9223372036854775807) (i32.const -2147483648))
(assert_return (invoke $a "multi" (i64.const -9223372036854775808) (i32.const 2147483647)) (i64.const -9223372036854775808) (i32.const 2147483647))
(assert_return (invoke $a "multi-ref" (i64.const -9223372036854775808) (i32.const 2147483647)) (i64.const -9223372036854775808) (i32.const 2147483647))
(assert_return (invoke $a "multi-indirect" (i64.const -9223372036854775808) (i32.const 2147483647)) (i64.const -9223372036854775808) (i32.const 2147483647))
(assert_return (invoke $c "foreign-multi" (i64.const -9223372036854775808) (i32.const 2147483647)) (i64.const -9223372036854775808) (i32.const 2147483647))
(assert_return (invoke $a "multi" (i64.const -1) (i32.const -1)) (i64.const -1) (i32.const -1))
(assert_return (invoke $a "multi-ref" (i64.const -1) (i32.const -1)) (i64.const -1) (i32.const -1))
(assert_return (invoke $a "multi-indirect" (i64.const -1) (i32.const -1)) (i64.const -1) (i32.const -1))
(assert_return (invoke $c "foreign-multi" (i64.const -1) (i32.const -1)) (i64.const -1) (i32.const -1))
(assert_trap (invoke $a "null" (i32.const 0)) "null reference")
(assert_trap (invoke $a "null-table" (i32.const 0)) "uninitialized element")
(assert_trap (invoke $a "bounds" (i32.const 0)) "undefined element")
(assert_trap (invoke $a "mismatch" (i32.const 0)) "indirect call type mismatch")
(assert_return (invoke $a "void"))
(assert_return (invoke $a "host"))
(assert_exhaustion (invoke $a "normal" (i32.const 100000)) "call stack exhausted")
(assert_return (invoke $a "i64-loop" (i32.const 100000) (i64.const 9223372036854775807)) (i64.const -9223372036854675809))
