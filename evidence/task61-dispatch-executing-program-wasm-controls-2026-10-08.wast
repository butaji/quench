(module $t (table (export "table") 3 funcref))

(register "t" $t)
(module $a
 (type $ii (func (param i32) (result i32)))
 (type $pair (func (param i64 i32) (result i64 i32)))
 (import "t" "table" (table $shared 3 funcref))
 (import "spectest" "print_i32_f32" (func $print (param i32 f32)))
 (table $local 1 funcref)
 (func $direct (export "direct") (type $ii)
  local.get 0 i32.eqz if (result i32) i32.const 31
  else local.get 0 i32.const 1 i32.sub return_call $direct end)
 (func $reference (export "reference") (type $ii)
  local.get 0 i32.eqz if (result i32) i32.const 37
  else local.get 0 i32.const 1 i32.sub ref.func $reference return_call_ref $ii end)
 (func $cross (export "cross") (type $ii)
  local.get 0 i32.eqz if (result i32) i32.const 17
  else local.get 0 i32.const 1 i32.sub i32.const 1 return_call_indirect $shared (type $ii) end)
 (func $i64-loop (export "i64-loop") (param i32 i64) (result i64)
  local.get 0 i32.eqz if (result i64) local.get 1
  else local.get 0 i32.const 1 i32.sub local.get 1 i64.const 1 i64.add return_call $i64-loop end)
 (func $normal (export "normal") (type $ii)
  local.get 0 i32.eqz if (result i32) i32.const 41
  else local.get 0 i32.const 1 i32.sub call $normal end)
 (func $pair (export "pair") (type $pair) local.get 0 local.get 1)
 (func (export "multi") (type $pair) local.get 0 local.get 1 return_call $pair)
 (func (export "multi-ref") (type $pair) local.get 0 local.get 1 ref.func $pair return_call_ref $pair)
 (func (export "multi-indirect") (type $pair)
  local.get 0 local.get 1 i32.const 0 return_call_indirect $local (type $pair))
 (func $void)
 (func (export "void") return_call $void)
 (func (export "host") i32.const 17 f32.const 32 return_call $print)
 (func (export "null") (type $ii) local.get 0 ref.null $ii return_call_ref $ii)
 (func (export "null-table") (type $ii) local.get 0 i32.const 2 return_call_indirect $shared (type $ii))
 (func (export "bounds") (type $ii) local.get 0 i32.const 65535 return_call_indirect $shared (type $ii))
 (func (export "mismatch") (type $ii) local.get 0 i32.const 0 return_call_indirect $local (type $ii))
 (elem (table $shared) (i32.const 0) func $cross)
 (elem (table $local) (i32.const 0) func $pair)
 (elem declare func $reference))

(register "a" $a)
(module $b
 (type $ii (func (param i32) (result i32)))
 (import "t" "table" (table $shared 3 funcref))
 (func $cross (export "cross") (type $ii)
  local.get 0 i32.eqz if (result i32) i32.const 19
  else local.get 0 i32.const 1 i32.sub i32.const 0 return_call_indirect $shared (type $ii) end)
 (elem (table $shared) (i32.const 1) func $cross))

(register "b" $b)
(module $c
 (type $ii (func (param i32) (result i32)))
 (type $pair (func (param i64 i32) (result i64 i32)))
 (import "a" "direct" (func $direct (type $ii)))
 (import "a" "reference" (func $reference (type $ii)))
 (import "a" "pair" (func $pair (type $pair)))
 (elem declare func $reference $pair)
 (func (export "foreign-direct") (type $ii) local.get 0 return_call $direct)
 (func (export "foreign-ref") (type $ii) local.get 0 ref.func $reference return_call_ref $ii)
 (func (export "foreign-multi") (type $pair) local.get 0 local.get 1 return_call $pair))

(register "c" $c)
(assert_return (invoke $a "direct" (i32.const 0)) (i32.const 31))
(assert_return (invoke $a "reference" (i32.const 0)) (i32.const 37))
(assert_return (invoke $a "cross" (i32.const 0)) (i32.const 17))
(assert_return (invoke $b "cross" (i32.const 0)) (i32.const 19))
(assert_return (invoke $c "foreign-direct" (i32.const 0)) (i32.const 31))
(assert_return (invoke $c "foreign-ref" (i32.const 0)) (i32.const 37))
(assert_return (invoke $a "direct" (i32.const 1)) (i32.const 31))
(assert_return (invoke $a "reference" (i32.const 1)) (i32.const 37))
(assert_return (invoke $a "cross" (i32.const 1)) (i32.const 19))
