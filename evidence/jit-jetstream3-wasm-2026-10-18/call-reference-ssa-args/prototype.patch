+    #[test]
+    fn compiled_wasm_indirect_cache_passes_typed_ssa_arguments() {
+        let signature = crate::WasmSignature {
+            params: vec![crate::WasmType::I32, crate::WasmType::I64],
+            results: vec![crate::WasmType::I64],
+        };
+        let mut sum = vec![
+            Operator::LocalGet { local_index: 0 },
+            Operator::I64ExtendI32S,
+            Operator::LocalGet { local_index: 1 },
+            Operator::I64Add,
+        ];
+        let increment = {
+            let mut body = sum.clone();
+            body.extend([
+                Operator::I64Const { value: 1 },
+                Operator::I64Add,
+                Operator::End,
+            ]);
+            body
+        };
+        sum.push(Operator::End);
+        let caller = vec![
+            Operator::LocalGet { local_index: 0 },
+            Operator::LocalGet { local_index: 1 },
+            Operator::I32Const { value: 0 },
+            Operator::CallIndirect {
+                type_index: 0,
+                table_index: 0,
+            },
+            Operator::End,
+        ];
+        let module = crate::Engine::lower_wasm_module_with_elements(
+            "compiled-indirect-cache-typed-ssa-arguments",
+            [
+                crate::WasmFunctionBody {
+                    ty: crate::WasmCallableType::Embedded(signature.clone()),
+                    locals: vec![],
+                    operators: sum.into_iter().map(Ok),
+                },
+                crate::WasmFunctionBody {
+                    ty: crate::WasmCallableType::Embedded(signature.clone()),
+                    locals: vec![],
+                    operators: increment.into_iter().map(Ok),
+                },
+                crate::WasmFunctionBody {
+                    ty: crate::WasmCallableType::Embedded(signature),
+                    locals: vec![],
+                    operators: caller.into_iter().map(Ok),
+                },
+            ],
+            &crate::WasmTypes::from_functions([wasmparser::FuncType::new(
+                [wasmparser::ValType::I32, wasmparser::ValType::I64],
+                [wasmparser::ValType::I64],
+            )]),
+            &[],
+            &[],
+            &[],
+            &[crate::WasmTable {
+                ty: wasmparser::TableType {
+                    element_type: wasmparser::RefType::FUNCREF,
+                    table64: false,
+                    initial: 1,
+                    maximum: Some(1),
+                    shared: false,
+                },
+                initializer: crate::WasmReferenceInitializer::Function(0).into(),
+            }],
+            &[crate::WasmElement {
+                mode: crate::WasmElementMode::Active {
+                    table: 0,
+                    offset: crate::WasmValue::I32(0).into(),
+                },
+                element_type: wasmparser::RefType::FUNCREF,
+                items: vec![crate::WasmReferenceInitializer::Function(0)].into(),
+            }],
+        )
+        .unwrap();
+        let mut vm = Vm::new(crate::SystemHost);
+        vm.set_execution_mode(crate::ExecutionMode::Compiled);
+        let instance = vm.instantiate_wasm_module(&module).unwrap();
+        let argument32 = i32::MIN + 7;
+        let argument64 = i64::MIN + 123;
+        let expected = i64::from(argument32).wrapping_add(argument64);
+        let args = [
+            crate::WasmValue::I32(argument32),
+            crate::WasmValue::I64(argument64),
+        ];
+
+        assert_eq!(
+            vm.invoke_wasm(&instance, 2, &args).unwrap(),
+            Some(crate::WasmValue::I64(expected))
+        );
+        assert_eq!(
+            vm.invoke_wasm(&instance, 2, &args).unwrap(),
+            Some(crate::WasmValue::I64(expected))
+        );
+        let program = vm
+            .programs
+            .find_shared(&module.program)
+            .expect("registered Wasm program");
+        let compiled = vm
+            .programs
+            .compiled(program)
+            .flatten()
+            .expect("indirect caller compiled");
+        assert!(compiled.reference_cache_hits() > 0);
+
+        let table = vm.wasm_table(&instance, 0).unwrap();
+        let replacement = vm.wasm_function(&instance, 1).unwrap();
+        vm.wasm_table_fill(table, 0, replacement, 1).unwrap();
+        let replaced_expected = expected.wrapping_add(1);
+        assert_eq!(
+            vm.invoke_wasm(&instance, 2, &args).unwrap(),
+            Some(crate::WasmValue::I64(replaced_expected))
+        );
+        assert_eq!(
+            vm.invoke_wasm(&instance, 2, &args).unwrap(),
+            Some(crate::WasmValue::I64(replaced_expected))
+        );
+        assert_eq!(compiled.reference_call_cache_target(0), Some(replacement));
+    }
