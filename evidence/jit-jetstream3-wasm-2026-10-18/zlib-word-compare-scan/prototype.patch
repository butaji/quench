+        let last_mismatch = self.builder.create_block();
+        self.builder
+            .ins()
+            .brif(last_byte, last_mismatch, &[], early_mismatch, &[]);
+
+        // The first seven mismatch exits set r5 to r3 + byte position.
+        self.builder.switch_to_block(early_mismatch);
