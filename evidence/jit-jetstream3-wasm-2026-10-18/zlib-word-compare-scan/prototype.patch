+        let right_address = self.builder.ins().iadd(self.base, right_start);
+        let flags = self.flags(Region::LinearMemory);
+        let left_word = self.builder.ins().load(types::I64, flags, left_address, 0);
+        let right_word = self.builder.ins().load(types::I64, flags, right_address, 0);
+        let difference = self.builder.ins().bxor(left_word, right_word);
+        let equal = self.builder.ins().icmp_imm_u(IntCC::Equal, difference, 0);
