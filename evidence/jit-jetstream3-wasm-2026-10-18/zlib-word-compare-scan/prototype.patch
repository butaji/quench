+        let base_address = self.read(3, Kind::I32);
+        let match_address = self.builder.ins().iadd(base_address, offset);
+        self.write(5, Kind::I32, match_address);
+        self.jump(88, false);
+
+        // The eighth compare follows PCs 65–66 before exiting.
+        self.builder.switch_to_block(last_mismatch);
+        let scan_index = self.read(8, Kind::I32);
+        let next_index = self.builder.ins().iadd_imm_s(scan_index, 8);
+        self.write(3, Kind::I32, next_index);
