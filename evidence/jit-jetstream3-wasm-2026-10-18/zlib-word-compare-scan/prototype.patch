+/// The full bytecode fingerprint of zlib's `longest_match` in the pinned
+/// JetStream Wasm fixture. Pinning the whole body also pins its predecessors,
+/// suffix liveness, and the fact that r21/r22 are overwritten before reuse.
+const ZLIB_LONGEST_MATCH_FINGERPRINT: u64 = 0x4568_8082_0ce8_d031;
+
+fn zlib_word_compare_scan_fingerprint(instructions: &[WideInstruction]) -> u64 {
+    fn feed(hash: &mut u64, bytes: &[u8]) {
+        for byte in bytes {
+            *hash = (*hash ^ u64::from(*byte)).wrapping_mul(0x0000_0100_0000_01b3);
+        }
+    }
+
+    let mut hash = 0xcbf2_9ce4_8422_2325;
+    for instruction in instructions {
+        feed(&mut hash, format!("{:?}", instruction.op()).as_bytes());
+        feed(&mut hash, &[0]);
+        feed(&mut hash, &instruction.a().to_le_bytes());
+        feed(&mut hash, &instruction.b().to_le_bytes());
+        feed(&mut hash, &instruction.c().to_le_bytes());
+        feed(&mut hash, &instruction.imm().to_le_bytes());
+    }
+    hash
+}
+
+/// The bytewise compare cascade in zlib's `longest_match`, in the pinned
+/// JetStream Wasm fixture. The full-body fingerprint keeps this experiment
+/// away from other code until it has a general, proven shape matcher.
+fn zlib_word_compare_scan_matches(function: usize, instructions: &[WideInstruction]) -> bool {
+    if function != 11
+        || instructions.len() != 109
+        || zlib_word_compare_scan_fingerprint(instructions) != ZLIB_LONGEST_MATCH_FINGERPRINT
+        || instructions.iter().any(|instruction| {
+            instruction.op() == Op::WasmMemoryGrow
+                || instruction.op().control_flow_layout() == ControlFlowLayout::Call
+        })
+    {
+        return false;
+    }
+    // Compilation admits only unshared Wasm memory, and this exact function
+    // contains no callouts or memory.grow that could change it mid-scan.
+    true
+}
