+        let right_start = self.builder.ins().iadd_imm_s(right_index, 1);
+        let left_end = self.builder.ins().iadd_imm_s(left_start, 8);
+        let right_end = self.builder.ins().iadd_imm_s(right_start, 8);
+        let memory_length = self.builder.ins().load(
+            types::I64,
+            MemFlagsData::trusted(),
+            self.context,
+            CONTEXT_MEMORY_LENGTH,
+        );
+        let left_in_bounds =
+            self.builder
+                .ins()
+                .icmp(IntCC::UnsignedLessThanOrEqual, left_end, memory_length);
+        let right_in_bounds =
+            self.builder
+                .ins()
+                .icmp(IntCC::UnsignedLessThanOrEqual, right_end, memory_length);
+        let in_bounds = self.builder.ins().band(left_in_bounds, right_in_bounds);
+        let fast = self.builder.create_block();
+        let slow = self.builder.create_block();
+        self.builder.ins().brif(in_bounds, fast, &[], slow, &[]);
+
+        // Keep the original scalar loads and branches intact for short tails
+        // and out-of-range pointers. This is needed even with guarded memory:
+        // an earlier mismatch can make a later scalar access unnecessary.
