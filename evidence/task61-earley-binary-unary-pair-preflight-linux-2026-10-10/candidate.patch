+fn fuse_binary_unary_jump_false(
+    window: &[Instr],
+    _: Option<Instr>,
+    superinstructions: &mut Vec<Superinstruction>,
+) -> Option<Instr> {
+    let [binary, unary, branch]: [Instr; 3] = window.try_into().ok()?;
+    if binary.result_flags() != 0
+        || unary.result_flags() != 0
+        || binary.result_register() != unary.register_b()
+        || unary.result_register() != branch.register_a()
+    {
+        return None;
+    }
+    let site = u16::try_from(superinstructions.len()).ok()?;
+    let instruction = Instr::try_new(
+        Op::SuperBinaryUnaryJumpFalse,
+        site,
+        branch.register_a(),
+        0,
+        branch.jump_target(),
+    )?;
+    let nop = Instr::new(Op::Nop, 0, 0, 0, 0);
+    superinstructions.push(Superinstruction {
+        code: [binary, unary, nop, nop],
+    });
+    Some(instruction)
+}
+
+fn fuse_binary_unary(
+    window: &[Instr],
+    next: Option<Instr>,
+    superinstructions: &mut Vec<Superinstruction>,
+) -> Option<Instr> {
+    let [binary, unary]: [Instr; 2] = window.try_into().ok()?;
+    if binary.result_flags() != 0
+        || unary.result_flags() != 0
+        || next.is_some_and(|instruction| {
+            instruction.op() == Op::JumpFalse
+                && instruction.register_a() == unary.result_register()
+        })
+    {
+        return None;
+    }
+    let site = superinstructions.len();
+    let instruction = Instr::try_new(
+        Op::SuperBinaryUnary,
+        0,
+        0,
+        0,
+        u32::try_from(site).ok()?,
+    )?;
+    let nop = Instr::new(Op::Nop, 0, 0, 0, 0);
+    superinstructions.push(Superinstruction {
+        code: [binary, unary, nop, nop],
+    });
+    Some(instruction)
+}
