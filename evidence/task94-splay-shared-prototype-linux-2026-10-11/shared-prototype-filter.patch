+#[test]
+fn full_mark_traces_shared_prototype_edges_across_collections() {
+    let mut heap = Heap::new();
+    let prototype = heap.alloc(Cell::Object(plain_object()));
+    let child = heap.alloc(Cell::String("prototype child".into()));
+    heap.property_push(prototype, child);
+    let first = heap.alloc(Cell::Object(Object::new(prototype)));
+    let second = heap.alloc(Cell::Object(Object::new(prototype)));
+
+    heap.collect([first, second]);
+    assert!(heap.get(prototype).is_some());
+    assert!(heap.get(child).is_some());
+
+    heap.property_set(prototype, 0, Value::UNDEFINED);
+    heap.collect([first]);
+    assert!(heap.get(prototype).is_some());
+    assert!(heap.get(child).is_none());
+}
