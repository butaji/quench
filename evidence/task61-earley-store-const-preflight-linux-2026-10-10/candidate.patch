+fn fuse_store_local_plain_load_const(
+    window: &[Instr],
+    superinstructions: &mut Vec<Superinstruction>,
+) -> Option<Instr> {
+    let [store, load]: [Instr; 2] = window.try_into().ok()?;
+    if store.result_flags() != 0 || load.result_flags() != 0 {
+        return None;
+    }
+    let site = u32::try_from(superinstructions.len()).ok()?;
+    let instruction = Instr::try_new(Op::SuperStoreLocalPlainLoadConst, 0, 0, 0, site)?;
+    let nop = Instr::new(Op::Nop, 0, 0, 0, 0);
+    superinstructions.push(Superinstruction {
+        code: [store, load, nop, nop],
+    });
+    Some(instruction)
+}
