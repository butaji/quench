@@ -1,6 +1,31 @@
 use super::*;
 
 impl<H: Host> Vm<H> {
+    #[inline(always)]
+    pub(super) fn execute_store_local_plain_load_const(
+        &mut self,
+        program: &ResidualProgram,
+        frame: usize,
+        instruction: WideInstruction,
+    ) -> Result<(), JsError> {
+        let [store, load, _, _] =
+            program.superinstructions[instruction.superinstruction_index()].code;
+        debug_assert_eq!(store.op(), Op::StoreLocalPlain);
+        debug_assert_eq!(load.op(), Op::LoadConst);
+        let value = self.read(frame, store.register_a());
+        // SAFETY: validation bounds the local slot by the current function.
+        unsafe { self.write_validated_local(frame, store.local_slot(), value) };
+        if let Some(register) = store.optional_register_b() {
+            self.write(frame, register, value);
+        }
+        let constant = self
+            .programs
+            .constant(self.frames[frame].program, load.constant_index())
+            .ok_or_else(|| JsError::validation("constant index is outside program".into()))?;
+        self.write(frame, load.result_register(), constant);
+        Ok(())
+    }
