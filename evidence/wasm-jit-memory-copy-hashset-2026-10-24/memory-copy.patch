+    #[test]
+    fn compiled_wasm_memory_copy_matches_the_interpreter() {
+        let memarg = wasmparser::MemArg {
+            align: 2,
+            max_align: 2,
+            offset: 0,
+            memory: 0,
+        };
+        let three_i32 = || {
+            crate::WasmCallableType::Embedded(crate::WasmSignature {
+                params: vec![crate::WasmType::I32; 3],
+                results: vec![crate::WasmType::I32],
+            })
+        };
+        // Each function moves bytes, then loads the word at its destination.
+        let body = |operator: Operator<'static>| crate::WasmFunctionBody {
+            ty: three_i32(),
+            locals: vec![],
+            operators: vec![
+                Operator::LocalGet { local_index: 0 },
+                Operator::LocalGet { local_index: 1 },
+                Operator::LocalGet { local_index: 2 },
+                operator,
+                Operator::LocalGet { local_index: 0 },
+                Operator::I32Load { memarg },
+                Operator::End,
+            ]
+            .into_iter()
+            .map(Ok),
+        };
+        let module = crate::Engine::lower_wasm_module_with_state(
+            "compiled-memory-copy",
+            [
+                body(Operator::MemoryFill { mem: 0 }),
+                body(Operator::MemoryCopy {
+                    dst_mem: 0,
+                    src_mem: 0,
+                }),
+            ],
+            &crate::WasmTypes::default(),
+            &[],
+            &[crate::WasmMemory {
+                ty: wasmparser::MemoryType {
+                    initial: 1,
+                    maximum: Some(1),
+                    memory64: false,
+                    shared: false,
+                    page_size_log2: None,
+                },
+                import: None,
+            }],
+            &[],
+        )
+        .unwrap();
+        let run = |mode| {
+            let mut vm = Vm::new(crate::SystemHost);
+            vm.set_execution_mode(mode);
+            let instance = vm.instantiate_wasm_module(&module).unwrap();
+            let mut call = |function, arguments: [i32; 3]| {
+                vm.invoke_wasm(&instance, function, &arguments.map(crate::WasmValue::I32))
+                    .map_err(|error| error.wasm_trap())
+            };
+            let results = vec![
+                call(0, [0, 0x11, 1]),
+                call(0, [1, 0x22, 1]),
+                call(0, [2, 0x33, 1]),
+                call(0, [3, 0x44, 1]),
+                // Overlapping in both directions.
+                call(1, [1, 0, 3]),
+                call(1, [0, 1, 3]),
+                // Either range out of bounds traps before any byte moves.
+                call(1, [0, 65_535, 2]),
+                call(1, [65_535, 0, 2]),
+                call(1, [0, 0, 0]),
+            ];
+            let program = vm
+                .programs
+                .find_shared(&module.program)
+                .expect("registered Wasm program");
+            let entries = vm
+                .programs
+                .compiled(program)
+                .flatten()
+                .and_then(|compiled| compiled.native_entries(1));
+            (results, entries)
+        };
+        let (interpreted, _) = run(crate::ExecutionMode::Interpreted);
+        let (compiled, entries) = run(crate::ExecutionMode::Compiled);
+        assert_eq!(compiled, interpreted);
+        assert_eq!(
+            interpreted[4..6],
+            [
+                Ok(Some(crate::WasmValue::I32(0x0033_2211))),
+                Ok(Some(crate::WasmValue::I32(0x3333_2211)))
+            ]
+        );
+        assert_eq!(
+            interpreted[6],
+            Err(Some(crate::WasmTrap::OutOfBoundsMemory))
+        );
+        assert_eq!(entries, Some(5));
+    }
