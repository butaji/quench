+/// Copy between already bounds-checked, possibly overlapping ranges of the instance's unshared
+/// memory, under the same proof as `compiled_memory_fill`.
+unsafe extern "C" fn compiled_memory_copy(destination: u64, source: u64, length: u64) -> i64 {
+    unsafe {
+        std::ptr::copy(
+            source as usize as *const u8,
+            destination as usize as *mut u8,
+            length as usize,
+        );
+    }
+    0
+}
