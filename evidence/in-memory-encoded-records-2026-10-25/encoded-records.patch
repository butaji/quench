@@ -1221,6 +1221,25 @@ pub(super) fn decode_deferred_function(
     Some(read_function(&mut reader).and_then(|function| reader.finish().map(|()| function)))
 }
 
+/// Appends `function`'s record to `bytes`, naming atoms by the program's own ids, as a
+/// deferred record that `decode_deferred_function` reads back.
+pub(super) fn append_function_record(
+    bytes: &mut Vec<u8>,
+    function: &Function,
+    superinstructions: &[super::Superinstruction],
+) -> super::DeferredRecord {
+    let mut out = BinaryWriter { bytes: std::mem::take(bytes), atoms: AtomEncoding::Program };
+    let start = out.bytes.len();
+    write_function(&mut out, function, superinstructions);
+    *bytes = out.bytes;
+    let record = &bytes[start..];
+    super::DeferredRecord {
+        start: u32::try_from(start).expect("deferred records fit u32 bytes"),
+        length: u32::try_from(record.len()).expect("a function record fits u32 bytes"),
+        checksum: compact_checksum(record),
+    }
+}
