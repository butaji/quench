+const mutations={none(){},nameData(f){Object.defineProperty(f,'name',{value:'anonymous'})},lengthData(f){Object.defineProperty(f,'length',{value:0})},lengthDescriptor(f){Object.defineProperty(f,'length',{configurable:false})},lengthGetter(f){Object.defineProperty(f,'length',{get(){return 0}})},deleteLength(f){delete f.length},restoreLength(f){delete f.length;Object.defineProperty(f,'length',{value:0,configurable:true})},readBefore(f){void f.name;void f.length}};
