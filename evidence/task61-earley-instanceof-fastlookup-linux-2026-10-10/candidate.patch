+    fn has_builtin_has_instance(&self, constructor: Value, symbol: Value) -> bool {
+        let Some(Cell::Function { object, .. }) = self.heap.get(constructor) else {
+            return false;
+        };
+        if object.proto != self.function_proto || self.symbol_property(constructor, symbol).is_some()
+        {
+            return false;
+        }
+        let Some(method) = self.symbol_property(self.function_proto, symbol) else {
+            return false;
+        };
+        let Some(attributes) =
+            self.property_attributes(self.function_proto, PropertyKey::symbol(symbol))
+        else {
+            return false;
+        };
+        !attributes.accessor
+            && matches!(
+                self.heap.get(method),
+                Some(Cell::Function {
+                    kind: FunctionKind::Native(Native::FunctionPrototypeHasInstance),
+                    ..
+                })
+            )
+    }
