+#[test]
+fn full_collection_releases_empty_slabs_and_preserves_generations() {
+    let mut heap = Heap::new();
+    let live = heap.alloc(Cell::String("live".into()));
+    let stale_value = (1..super::slots::SLOTS_PER_SLAB * 2)
+        .map(|_| heap.alloc(Cell::String("dead".into())))
+        .last()
+        .unwrap();
+    let stale = heap.weak_handle(stale_value).unwrap();
+
+    heap.collect([live]);
+
+    assert_eq!(heap.slots.len(), super::slots::SLOTS_PER_SLAB * 2);
+    assert_eq!(heap.slots.capacity(), super::slots::SLOTS_PER_SLAB);
+    assert!(heap.weak_value(stale).is_none());
+
+    let replacement = std::iter::from_fn(|| Some(heap.alloc(Cell::String("new".into()))))
+        .find(|value| value.heap_index() == Some(stale.slot))
+        .unwrap();
+    let replacement_handle = heap.weak_handle(replacement).unwrap();
+    assert_ne!(replacement_handle.generation, stale.generation);
+    assert_eq!(heap.slots.capacity(), super::slots::SLOTS_PER_SLAB * 2);
+    assert!(heap.weak_value(stale).is_none());
+    assert_eq!(heap.weak_value(replacement_handle), Some(replacement));
+}
+
+#[test]
+fn released_exhausted_generations_retire_on_slot_reuse() {
+    let mut heap = Heap::new();
+    let live = heap.alloc(Cell::String("live".into()));
+    let exhausted_value = (1..super::slots::SLOTS_PER_SLAB * 2)
+        .map(|_| heap.alloc(Cell::String("dead".into())))
+        .last()
+        .unwrap();
+    let exhausted_slot = exhausted_value.heap_index().unwrap() as usize;
+    heap.generations[exhausted_slot] = u32::MAX;
+    let stale = heap.weak_handle(exhausted_value).unwrap();
+
+    heap.collect([live]);
+
+    assert_eq!(heap.slots.len(), super::slots::SLOTS_PER_SLAB * 2);
+    assert_eq!(heap.slots.capacity(), super::slots::SLOTS_PER_SLAB);
+    assert!(heap.weak_value(stale).is_none());
+
+    let replacement = std::iter::from_fn(|| Some(heap.alloc(Cell::String("new".into()))))
+        .find(|value| {
+            value
+                .heap_index()
+                .is_some_and(|slot| slot as usize > exhausted_slot)
+        })
+        .unwrap();
+    assert_eq!(heap.retired_slots, 1);
+    assert!(heap.weak_value(stale).is_none());
+    assert!(replacement.heap_index().unwrap() as usize > exhausted_slot);
+}
