  "change": {
    "authority": "NodeHost constructs one ProcessControl Rc<Cell> owner for process start time, exit status, and umask, then shares it with SharedNodeState and legacy ProcessState.",
    "shared_path": "Shared process uptime, exitCode, umask, finish status, unhandled-rejection status, perf_hooks.now, and the shared runner read/write ProcessControl through SharedNodeState.",
    "legacy_path": "Legacy process APIs, pump/test exit handling, NodeHost exit status, and simulated cluster child save/clear/capture/restore/take operations use the same ProcessControl cells.",
    "transitions": "Initial umask remains 0o022; updates return the previous mask and retain 0o777 masking. Invalid octal strings now receive ERR_INVALID_ARG_VALUE while invalid argument types retain ERR_INVALID_ARG_TYPE. Immediate exit_requested and lifecycle handlers remain adapter execution state.",
    "inventory_membership_changed": false
  },
