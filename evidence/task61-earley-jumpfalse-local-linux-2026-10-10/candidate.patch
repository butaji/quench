+pub(super) fn apply_branch_local_fusion(function: &mut BcFunction) {
+    rewrite_branch_local_window(function);
+}
+
+fn rewrite_branch_local_window(function: &mut BcFunction) -> bool {
+    let mut changed = false;
+    for index in 0..function.code.len().saturating_sub(1) {
+        let branch = function.code[index];
+        let local = function.code[index + 1];
+        if branch.op() != Op::JumpFalse
+            || local.op() != Op::LoadLocalPlain
+            || branch.result_flags() != 0
+            || local.result_flags() != 0
+            || local.numeric_local_store_target().is_some()
+        {
+            continue;
+        }
+        let Ok(slot) = u16::try_from(local.local_slot()) else {
+            continue;
+        };
+        let Some(fused) = Instr::try_new(
+            Op::JumpFalseLoadLocalSkip,
+            branch.register_a(),
+            local.result_register(),
+            slot,
+            branch.jump_target(),
+        ) else {
+            continue;
+        };
+        function.code[index] = fused;
+        changed = true;
+    }
+    changed
+}
