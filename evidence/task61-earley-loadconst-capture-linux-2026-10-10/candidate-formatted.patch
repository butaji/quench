+fn fuse_load_const_capture(
+    window: &[Instr],
+    superinstructions: &mut Vec<Superinstruction>,
+) -> Option<Instr> {
+    let code: [Instr; 2] = window.try_into().ok()?;
+    if code.map(|instruction| instruction.op()) != LOAD_CONST_CAPTURE
+        || code.iter().any(|instruction| instruction.result_flags() != 0)
+    {
+        return None;
+    }
+    let site = superinstructions.len() as u32;
+    let nop = Instr::new(Op::Nop, 0, 0, 0, 0);
+    superinstructions.push(Superinstruction {
+        code: [code[0], code[1], nop, nop],
+    });
+    Instr::try_new(Op::SuperLoadConstCapture, 0, 0, 0, site)
+}
