+        let mut status = 0;
+        // SAFETY: the name is NUL-terminated and the status output is live.
+        let raw = unsafe { open(name.as_ptr(), &mut status) };
+        let handle = Self(ptr::NonNull::new(raw).ok_or(status.max(ILLEGAL_ARGUMENT))?);
+        if status > 0 {
+            return Err(status);
+        }
+        Ok(handle)
+    }
