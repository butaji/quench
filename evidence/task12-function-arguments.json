  "representation": {
    "authority": "Each eligible invocation owns one original-argument vector. Shared initialize_frame_invocation sets callable context, clears old arguments and snapshots only eligible legacy function calls. Ordinary, numeric, reused and generator paths call that operation.",
    "lifecycle": "GC projects original argument roots. Continuation transitions move the vector with the rest of the activation; recycling clears it and applies the existing named frame-value retention policy.",
    "projection": "Each function.arguments read creates a fresh unmapped arguments object using the existing initializer, original values, simple-parameter callee policy and current-realm object prototype. No derived argument object or local values are used as snapshot authority.",
    "cost": "An eligible invocation copies values because locals/mapped arguments can mutate or disappear; ineligible invocations copy nothing. Guest arguments-object allocation occurs only on a read. Continuation transitions move owned data without copying.",
    "scope": "No new serializer field, dependency, fixture branch, parallel reflection stack or duplicated guest-semantic unit test. Source formatting changes were verified to preserve the non-whitespace bytes."
  },
  "contract": {
    "proposal_cited_by_pinned_tests": "https://github.com/claudepache/es-legacy-function-reflection/blob/master/spec.md",
    "status": "Legacy-reflection proposal; no universal Node parity or complete proposal-implementation claim.",
    "pinned_fixture": "staging/sm/extensions/arguments-property-access-in-function.js",
    "node_difference": "After assigning the formal parameter, current Node exposes its changed value in f.arguments; Quench preserves the original invocation value, as required by the proposal ArgumentsList snapshot. Retained both normal/generic controls."
