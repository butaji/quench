+    fn small_loop_headers(&self, final_order: &[BlockIndex]) -> Vec<bool> {
+        let mut aligned = vec![false; self.num_blocks()];
+        if I::small_loop_alignment() <= 1 {
+            return aligned;
+        }
+        let mut position = vec![usize::MAX; self.num_blocks()];
