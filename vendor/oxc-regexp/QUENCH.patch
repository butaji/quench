+#[cold]
+pub fn stack_exhausted(span: Span) -> OxcDiagnostic {
+    OxcDiagnostic::error(quench_stack::STACK_EXHAUSTED_MESSAGE)
+        .with_error_code_num(crate::STACK_EXHAUSTION_ERROR_CODE)
+        .with_label(span)
+}
