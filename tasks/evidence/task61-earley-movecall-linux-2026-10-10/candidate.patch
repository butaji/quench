+    MoveIntoCall: [Move, Call] =>
+        |first: Instr, mut second: Instr, _: &mut Vec<FieldSite>| {
+            let destination = first.result_register();
+            let source = first.register_b();
+            if destination == second.result_register() {
+                // A throwing call can leave the moved value visible to a handler.
+                return None;
