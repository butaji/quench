+            if is_argument {
+                if window.count != 1 || window.base != destination {
+                    return None;
+                }
+                second.set_imm(ImmediateLayout::call_immediate(
+                    source,
+                    1,
+                    second.direct_eval(),
+                    second.parameter_eval(),
+                ));
+            }
+            if destination == second.register_b() {
+                second.set_b(source);
+            }
+            if destination == second.register_c() {
+                second.set_c(source);
+            }
+            Some(second)
+        };
