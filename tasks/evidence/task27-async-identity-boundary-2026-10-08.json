  "change": {
    "authority": "NodeHost constructs one AsyncIdentity and passes shallow handles to HostState.async_hooks and SharedNodeState.async_hooks. It owns next async ID, current async ID, and next AsyncLocalStorage ID.",
    "shared_path": "Shared AsyncHooks operations and HTTP poll/context handling read and update identity through SharedNodeState; HTTP shared poll no longer accepts HostState.",
    "legacy_path": "Legacy callbacks use the same identity handle. Legacy Value hook callbacks, current resources, and resource stack remain in HostState; shared RootId local-store values remain in SharedNodeState.",
    "transitions": "Identity allocate/replace operations preserve the existing root ID 1, no-trigger ID 0, first resource ID 2, and first local-storage ID 1.",
    "inventory_membership_changed": false
  },
