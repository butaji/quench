  "change": {
    "authority": "ProcessArgs(Rc<[String]>) is constructed once per NodeHost and cloned into SharedNodeState and ProcessState; both views read the same immutable host input.",
    "guest_process_argv": "The shared adapter materializes a separate rooted JavaScript Array from ProcessArgs, so guest mutations do not modify the host startup vector.",
    "api_boundary": "HostState.process and ProcessState.argv are crate-private; ProcessState::argv() exposes a read-only slice. This prevents downstream embedders from replacing one host view and splitting the shared source.",
    "readers": [
      "modules/process/shared_vm.rs materializes shared process.argv",
      "modules/require.rs uses the same initial arguments in the legacy process-module fallback",
      "modules/util.rs reads argv[1] for the legacy source-map script name"
    ],
    "inventory_membership_changed": false,
    "runtime_dependency_removed": false
  },
