+    fn install_stack_limit(
+        &self,
+        entry_frame: usize,
+        stack_guard: &crate::stack::StackGuard,
+    ) -> StackLimitRestore {
+        let previous = self.stack_limit.get();
+        let inherited_frames = previous
+            .map(|limit| {
+                let frames_since_outer_entry =
+                    self.frames.len().saturating_sub(limit.frame_depth_at_entry);
+                let entry_frame_has_its_own_stack_guard = entry_frame >= limit.frame_depth_at_entry
+                    && entry_frame == self.frames.len().saturating_sub(1);
+                frames_since_outer_entry
+                    .saturating_sub(usize::from(entry_frame_has_its_own_stack_guard))
+            })
+            .unwrap_or(0);
+        self.stack_limit.set(Some(StackLimit {
+            origin: stack_guard.origin(),
+            transition_depth: stack_guard
+                .transition_depth()
+                .saturating_add(inherited_frames),
+            frame_depth_at_entry: self.frames.len(),
+        }));
+        StackLimitRestore {
+            value: Rc::clone(&self.stack_limit),
+            previous,
+        }
+    }
+
+    fn check_guest_frame_stack(&mut self) -> Result<(), JsError> {
+        let stack_pointer = crate::stack::current_stack_pointer();
+        let limit = self.stack_limit.get().unwrap_or(StackLimit {
+            origin: stack_pointer,
+            transition_depth: 0,
+            frame_depth_at_entry: 0,
+        });
+        let frame_transitions = self.frames.len().saturating_sub(limit.frame_depth_at_entry);
+        let transition_depth = limit.transition_depth.saturating_add(frame_transitions);
+        if stack_pointer.abs_diff(limit.origin) > crate::stack::STACK_BUDGET_BYTES
+            || transition_depth > crate::stack::MAX_RECURSIVE_TRANSITIONS
+        {
+            Err(self.stack_exhaustion_error())
+        } else {
+            Ok(())
+        }
+    }
