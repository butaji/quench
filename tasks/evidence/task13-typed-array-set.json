  "representation": {
    "content_type": "TypedArrayKind::is_bigint derives numeric content from the existing kind enum for typed copying. No new state.",
    "ordering": "Require a TypedArray receiver before offset coercion; defer bounds validation until after offset conversion and negative-offset rejection. Preserve source validation and LengthOfArrayLike effects before positive-infinite offset rejection. The immutable-buffer proposal keeps its earlier write rejection.",
    "roots": "Source, receiver, offset and boxed arraylike source stay rooted across observable effects. Source is reread from its root after offset coercion.",
    "copy": "Same-kind copies use exact backing bytes and overlap-safe copying. Different kinds convert through the shared element operation; only aliased backing needs a snapshot of owned converted elements. Empty numeric/BigInt mismatches still reject.",
    "reduction": "Removed the old value-vector set branch and unreachable common set validation. Copy-elements names the validated no-guest-effects operation for typed source copying; arraylike sources retain their separate observable property and conversion loop."
  },
  "spec": "https://tc39.es/ecma262/multipage/indexed-collections.html#sec-%typedarray%.prototype.set",
