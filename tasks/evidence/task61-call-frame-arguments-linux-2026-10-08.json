  "hypotheses": {
    "call_roots": "Dynamic Call already publishes its paused caller frame at the call PC, whose root map covers the callee, receiver and argument window. Rebuilding a temporary root list is redundant. Method getters may produce a callee absent from the frame, so method calls retain an explicit callee root. Wasm terminal calls still use the explicit-root path after clearing their guest frame.",
    "argument_storage": "CallArguments previously initialized eight Value slots and kept an optional Vec for overflow. SmallVec stores up to eight values inline and spills larger calls to the heap."
  },
  "research": [
    {
      "url": "https://docs.rs/smallvec/latest/smallvec/",
      "accessed": "2026-10-08",
      "finding": "The current docs describe inline storage with heap fallback and note that the optional union feature removes one machine-word tag. The implementation here remains pinned to smallvec 1.15.2; the newer feature is not enabled without a separate measurement."
    },
    {
      "url": "https://github.com/google/benchmark/blob/main/docs/reducing_variance.md",
      "accessed": "2026-10-08",
      "finding": "The guide identifies CPU placement, frequency changes, scheduling, and cache activity as benchmark variance sources. Measurements used alternating 11-pair samples on the same host and report paired intervals."
    }
  ],
