{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quench.dev/schemas/perf-workload.json",
  "title": "Quench performance workload snapshot",
  "description": "One source-owned final measurement snapshot. Missing and null fields are invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["iterations", "checksum", "allocations", "copies", "bytes", "peak_rss", "wall_ms"],
  "properties": {
    "iterations": { "type": "integer", "minimum": 0 },
    "checksum": { "type": "integer", "minimum": 0 },
    "allocations": { "type": "integer", "minimum": 0 },
    "copies": { "type": "integer", "minimum": 0 },
    "bytes": { "type": "integer", "minimum": 0 },
    "peak_rss": { "type": "integer", "minimum": 1 },
    "wall_ms": { "type": "number", "minimum": 0 }
  }
}
