#!/usr/bin/env bash
set -euo pipefail

# SSOT is the canonical shorthand for implementation status of the current
# test-run stage. This is the single command you should use for status/checkpoint
# loops.
# Usage:
#   bash tools/ssot                         # status snapshot for current test-run stage
#   bash tools/ssot --run                   # run current stage test-run (explicit)
#   bash tools/ssot --status                # status snapshot for current stage
#   bash tools/ssot --run --commit           # run, then commit current milestone
#   bash tools/ssot --run --commit --push    # run, commit, and push current milestone
#   bash tools/ssot --run --json             # run current stage with JSON stage result
#   bash tools/ssot --status                # show current test-run summary
#   bash tools/ssot --status --json         # show summary JSON
#   bash tools/ssot --next                  # print next pending stage id
#   bash tools/ssot --next --run             # run next pending stage
#   bash tools/ssot --next --run --commit    # run next and commit milestone
#   bash tools/ssot --next --run --commit --push
#                                         # run next, commit, and push milestone
# Fast path:
#   bash tools/ssot --run --fast               # run current stage without preflight
#   bash tools/ssot --next --run --fast        # run next stage without preflight
#   bash tools/ssot --next --run --fast --commit --push
#                                          # fast milestone flow
# Momentum path:
#   bash tools/ssot --sprint                  # check blocker status, then run fast test-run
#   bash tools/ssot --sprint --commit         # run current stage fast, commit if tests pass
#   bash tools/ssot --sprint --commit --push    # run fast, commit, push current milestone

RUN=0
STATUS=0
STAGE=""
NEXT=0
JSON=0
COMMIT=0
PUSH=0
FAST=0
SPRINT=0
COMMIT_MESSAGE=""

while [[ ${#} -gt 0 ]]; do
  case "${1:-}" in
    --status)
      STATUS=1
      shift
      ;;
    --next)
      NEXT=1
      shift
      ;;
    --run|--test|--test-run)
      RUN=1
      shift
      ;;
    --json)
      JSON=1
      shift
      ;;
    --fast)
      FAST=1
      shift
      ;;
    --sprint)
      SPRINT=1
      shift
      ;;
    --stage)
      STAGE="$2"
      shift 2
      ;;
    --commit)
      COMMIT=1
      if [[ ${2:-} != --* && ${2:-} != "" ]]; then
        COMMIT_MESSAGE="$2"
        shift 2
      else
        shift
      fi
      ;;
    --push)
      PUSH=1
      shift
      ;;
    --help|-h)
      sed -n '1,200p' "$0"
      exit 0
      ;;
    *)
      echo "error: unexpected argument: $1" >&2
      exit 1
      ;;
  esac
done

if [[ "$STATUS" -eq 1 ]]; then
  if [[ "$NEXT" -eq 1 ]]; then
    if [[ "$JSON" -eq 1 ]]; then
      bash tools/test-run-go-next.sh --status --json
    else
      bash tools/test-run-go-next.sh --status
    fi
    exit 0
  fi
  if [[ -n "$STAGE" ]]; then
    echo "error: --stage is not supported with --status" >&2
    exit 1
  fi
  if [[ "$COMMIT" -eq 1 || "$PUSH" -eq 1 ]]; then
    echo "error: --commit/--push are not supported with --status" >&2
    exit 1
  fi
  if [[ "$JSON" -eq 1 ]]; then
    bash tools/test-run-status-summary.sh --json
  else
    bash tools/test-run-status-summary.sh
  fi
  exit 0
fi

if [[ "$PUSH" -eq 1 && "$COMMIT" -eq 0 ]]; then
  echo "error: --push requires --commit" >&2
  exit 1
fi

if [[ "$SPRINT" -eq 0 && "$COMMIT" -eq 1 && "$RUN" -eq 0 && "$JSON" -eq 0 ]]; then
  echo "error: --commit requires --run" >&2
  exit 1
fi

if [[ "$SPRINT" -eq 1 ]]; then
  if [[ "$STATUS" -eq 1 || "$NEXT" -eq 1 || -n "$STAGE" || "$JSON" -eq 1 || "$RUN" -eq 1 || "$PUSH" -eq 1 ]]; then
    echo "error: --sprint is exclusive and implies fast run for current stage" >&2
    exit 1
  fi

  SPRINT_STATUS="$(bash tools/test-run-status-summary.sh --json)"
  IS_BLOCKED="$(python3 - "$SPRINT_STATUS" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1]) if len(sys.argv) > 1 else {}
status = payload.get("test_run_status_summary", {}) if isinstance(payload, dict) else {}
print(1 if status.get("is_blocked", False) else 0)
PY
)"

  if [[ "$IS_BLOCKED" -eq 1 ]]; then
    echo "sprint blocked: current stage has existing failures" >&2
    bash tools/test-run-status-summary.sh
    exit 1
  fi

  if [[ "$COMMIT" -eq 1 && "$PUSH" -eq 1 ]]; then
    bash tools/ssot --run --fast --commit --push
  elif [[ "$COMMIT" -eq 1 ]]; then
    bash tools/ssot --run --fast --commit
  else
    bash tools/ssot --run --fast
  fi
  exit 0
fi

if [[ "$RUN" -eq 1 || "$STAGE" != "" ]]; then
  if [[ "$COMMIT" -eq 1 ]]; then
    if [[ "$JSON" -eq 1 ]]; then
      echo "error: --json is not supported with --commit in this command" >&2
      exit 1
    fi
    STAGE_ARGS=()
    if [[ -n "$STAGE" ]]; then
      STAGE_ARGS+=(--stage "$STAGE")
    fi
    STAGE_ARGS+=(--test-run)
    if [[ -n "$COMMIT_MESSAGE" ]]; then
      STAGE_ARGS+=(--commit "$COMMIT_MESSAGE")
    else
      STAGE_ARGS+=(--commit)
    fi
    if [[ "$PUSH" -eq 1 ]]; then
      STAGE_ARGS+=(--push)
    fi
    bash tools/milestone.sh "${STAGE_ARGS[@]}"
  elif [[ "$NEXT" -eq 1 ]]; then
    GO_NEXT_ARGS=(--run)
    if [[ "$FAST" -eq 1 ]]; then
      GO_NEXT_ARGS+=(--no-preflight)
    fi
    if [[ "$PUSH" -eq 1 ]]; then
      GO_NEXT_ARGS+=(--push)
    fi
    if [[ -n "$COMMIT_MESSAGE" ]]; then
      GO_NEXT_ARGS+=(--commit "$COMMIT_MESSAGE")
    elif [[ "$COMMIT" -eq 1 ]]; then
      GO_NEXT_ARGS+=(--commit)
    fi
    bash tools/test-run-go-next.sh "${GO_NEXT_ARGS[@]}"
  elif [[ "$RUN" -eq 1 ]]; then
    if [[ -n "$STAGE" ]]; then
      if [[ "$JSON" -eq 1 ]]; then
        TEST262_STAGE="$STAGE" bash tools/test-run-stage.sh --json
      else
        TEST262_STAGE="$STAGE" bash tools/test-run-stage.sh
      fi
    else
      if [[ "$JSON" -eq 1 ]]; then
        if [[ "$FAST" -eq 1 ]]; then
          bash tools/test-run-go.sh --run --json --no-preflight
        else
          bash tools/test-run-go.sh --run --json
        fi
      else
        if [[ "$FAST" -eq 1 ]]; then
          bash tools/test-run-go.sh --run --no-preflight
        else
          bash tools/test-run-go.sh --run
        fi
      fi
    fi
  else
    STAGE_ARGS=(--stage "$STAGE")
    if [[ "$JSON" -eq 1 ]]; then
      STAGE_ARGS+=(--json)
    fi
    bash tools/test-run-stage.sh "${STAGE_ARGS[@]}"
  fi
  exit 0
fi

if [[ "$NEXT" -eq 1 && -n "$STAGE" ]]; then
  echo "error: --next and --stage are mutually exclusive" >&2
  exit 1
fi

if [[ "$NEXT" -eq 1 ]]; then
  bash tools/test-run-go-next.sh --print
  exit 0
fi

STAGE_ARGS=()
if [[ "$JSON" -eq 1 ]]; then
  STAGE_ARGS+=(--json)
fi
bash tools/test-run-stage.sh "${STAGE_ARGS[@]}"
